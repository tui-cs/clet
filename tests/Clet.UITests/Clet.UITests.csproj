<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Clet.UITests</RootNamespace>
    </PropertyGroup>

  <!-- Source-tree path baked in at build time so CLET_REGEN_GOLDENS=1 writes goldens
       back into source rather than the bin directory. CletUiHarness reads this via
       AssemblyMetadataAttribute. -->
    <ItemGroup>
        <AssemblyMetadata Include="GoldensSourcePath" Value="$(MSBuildProjectDirectory)/Goldens" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="2.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Clet/Clet.csproj" />
        <ProjectReference Include="../../src/Terminal.Gui.Cli/Terminal.Gui.Cli.csproj" />
    </ItemGroup>

    <!-- Goldens travel with the test binary so AssertMatchesGolden can find them at runtime. -->
    <ItemGroup>
        <None Update="Goldens/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
